+/**
+ * Restrict MCP read to conversations actually indexed under the local archive.
+ * A "DO NOT INDEX" marker must also block direct read by an agent.
+ */
+function indexedArchivePath(requested: string): string {
+  if (!path.isAbsolute(requested)) throw new Error('Archive path required');
+  const root = fs.realpathSync(getArchiveDir());
+  const resolved = fs.realpathSync(requested);
+  if (!path.resolve(requested).startsWith(root + path.sep) ||
+      !resolved.startsWith(root + path.sep)) {
+    throw new Error('Conversation is outside the permitted archive');
+  }
+  const db = new Database(getDbPath(), { readonly: true, fileMustExist: true });
+  try {
+    const found = db.prepare(
+      'SELECT 1 FROM exchanges WHERE archive_path = ? OR archive_path = ? LIMIT 1'
+    ).get(resolved, requested);
+    if (!found) throw new Error('Conversation is not indexed');
+  } finally {
+    db.close();
+  }
+  if (shouldSkipConversation(resolved)) {
+    throw new Error('Conversation is excluded from indexing');
+  }
+  return resolved;
+}
