+    const hidden = join(archive, 'hidden.jsonl');
+    writeFileSync(safe, '{}\n');
+    writeFileSync(hidden, '{}\n');
+    const db = initDatabase();
+    for (const [id, file] of [['allowed', safe], ['secret', hidden]]) {
+      insertExchange(db, {
+        id, project: 'synthetic', timestamp: '2026-10-24T00:00:00.000Z',
