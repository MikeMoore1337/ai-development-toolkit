+describe('indexed conversation exclusion on retrieval', () => {
+  let directory: string;
+  const previousDbPath = process.env.TEST_DB_PATH;
+  beforeEach(() => {
+    directory = mkdtempSync(join(tmpdir(), 'episodic-exclusion-'));
+    process.env.TEST_DB_PATH = join(directory, 'index.sqlite');
+    process.env.TEST_ARCHIVE_DIR = join(directory, 'archive');
+    process.env.TEST_PROJECTS_DIR = join(directory, 'sources');
+    process.env.EPISODIC_MEMORY_CONFIG_DIR = join(directory, 'config');
