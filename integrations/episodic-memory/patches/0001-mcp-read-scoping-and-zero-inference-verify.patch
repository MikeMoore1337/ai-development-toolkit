+/**
+ * Re-check the live source as well as the archived copy. A source can acquire
+ * a DO NOT INDEX marker after it was archived; a stale DB and old archive
+ * must never expose that session through search or MCP read.
+ */
+export function shouldSkipIndexedArchive(archivePath: string): boolean {
+  const root = path.resolve(getArchiveDir());
+  const relative = path.relative(root, path.resolve(archivePath));
+  if (!relative || relative === '..' || relative.startsWith('..' + path.sep) ||
+      path.isAbsolute(relative)) return true;
+  // An indexed path can be replaced by a symlink/junction after indexing.
+  // Lexical containment is insufficient: search results include stored DB text.
+  let resolvedArchive: string;
+  try {
+    const physicalRoot = fs.realpathSync(root);
+    resolvedArchive = fs.realpathSync(archivePath);
+    const physicalRelative = path.relative(physicalRoot, resolvedArchive);
+    if (!physicalRelative || physicalRelative === '..' ||
+        physicalRelative.startsWith('..' + path.sep) ||
+        path.isAbsolute(physicalRelative)) return true;
+  } catch {
+    return true; // Missing or unreadable archive: fail closed.
+  }
+  if (shouldSkipConversation(resolvedArchive)) return true;
+  for (const sourceDir of getConversationSourceDirs()) {
+    const sourcePath = path.join(sourceDir, relative);
+    if (fs.existsSync(sourcePath) && shouldSkipConversation(sourcePath)) return true;
+  }
+  return false;
+}
